{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Translator",
  "version": "0.1.0",
  "identifier": "com.screentranslator.app",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Screen Translator",
        "url": "index.html",
        "width": 460,
        "height": 820,
        "minWidth": 400,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "x": 0,
        "y": 0,
        "width": 400,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
